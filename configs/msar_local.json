{
  "dataset_repo_url": "https://github.com/airtlab/A-Dataset-for-Automatic-Violence-Detection-in-Videos.git",
  "dataset_repo_dir": "data/AIRTLab",
  "cache_root": "cache/msar_features",
  "runs_root": "runs",
  "weights_root": "weights",
  "pose_model_url": "https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/1/pose_landmarker_full.task",
  "pose_model_filename": "pose_landmarker_full.task",
  "yolo_weight": "yolov9c.pt",
  "det_conf": 0.25,
  "det_iou": 0.5,
  "det_imgsz": 640,
  "deepsort_max_iou_distance": 0.7,
  "deepsort_max_age": 30,
  "deepsort_n_init": 3,
  "deepsort_max_cosine_distance": 0.2,
  "pose_min_detection_confidence": 0.5,
  "pose_min_presence_confidence": 0.5,
  "pose_min_tracking_confidence": 0.5,
  "max_people": 4,
  "n_landmarks": 33,
  "features_per_landmark": 3,
  "coordinate_mode": "crop_normalized",
  "frame_stride": 1,
  "crop_padding": 0.1,
  "rnn_units": 50,
  "dropout": 0.2,
  "epochs": 50,
  "batch_size": 16,
  "learning_rate": 0.001,
  "test_size": 0.25,
  "seeds": [11, 22, 33, 44, 55],
  "cache_schema_version": "python313-local-v1",
  "allow_partial_extraction": false
}
